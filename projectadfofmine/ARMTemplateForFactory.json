							{
								"referenceName": "DSADLSSink",
								"type": "DatasetReference",
								"parameters": {}
							}
						]
					}
				],
				"policy": {
					"elapsedTimeMetric": {}
				},
				"annotations": [],
				"lastPublishTime": "2026-08-06T10:16:28Z"
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/datasets/DS_Source_HTTP')]",
				"[concat(variables('factoryId'), '/datasets/DSADLSSink')]"
			]
