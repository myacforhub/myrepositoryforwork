{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "projectadfofmine"
		},
		"LS2ADLSDestination_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'LS2ADLSDestination'"
		},
		"LS_ADLsGen2_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'LS_ADLsGen2'"
		},
		"LS_postgresToAdls_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'LS_postgresToAdls'"
		},
		"ds_PostgreSql_source_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'ds_PostgreSql_source'"
		},
		"LS1HttpSource_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://raw.githubusercontent.com"
		},
		"LS2ADLSDestination_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://myadlsgen2ac.dfs.core.windows.net/"
		},
		"LS_ADLsGen2_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://myadlsgen2ac.dfs.core.windows.net/"
		},
		"LS_postgresToAdls_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "localhost"
		},
		"LS_postgresToAdls_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "dvdrental"
		},
		"LS_postgresToAdls_properties_typeProperties_username": {
			"type": "string",
			"defaultValue": "postgres "
		},
		"ds_PostgreSql_source_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "localhost"
		},
		"ds_PostgreSql_source_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "dvdrental"
		},
		"ds_PostgreSql_source_properties_typeProperties_username": {
			"type": "string",
			"defaultValue": "postgres"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "projectadfofmine_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"LS_postgresToAdls_password": {
						"value": "[parameters('LS_postgresToAdls_password')]"
					},
					"ds_PostgreSql_source_password": {
						"value": "[parameters('ds_PostgreSql_source_password')]"
					},
					"LS2ADLSDestination_accountKey": {
						"value": "[parameters('LS2ADLSDestination_accountKey')]"
					},
					"LS_ADLsGen2_accountKey": {
						"value": "[parameters('LS_ADLsGen2_accountKey')]"
					},
					"LS_postgresToAdls_properties_typeProperties_server": {
						"value": "[parameters('LS_postgresToAdls_properties_typeProperties_server')]"
					},
					"LS_postgresToAdls_properties_typeProperties_database": {
						"value": "[parameters('LS_postgresToAdls_properties_typeProperties_database')]"
					},
					"LS_postgresToAdls_properties_typeProperties_username": {
						"value": "[parameters('LS_postgresToAdls_properties_typeProperties_username')]"
					},
					"ds_PostgreSql_source_properties_typeProperties_server": {
						"value": "[parameters('ds_PostgreSql_source_properties_typeProperties_server')]"
					},
					"ds_PostgreSql_source_properties_typeProperties_database": {
						"value": "[parameters('ds_PostgreSql_source_properties_typeProperties_database')]"
					},
					"ds_PostgreSql_source_properties_typeProperties_username": {
						"value": "[parameters('ds_PostgreSql_source_properties_typeProperties_username')]"
					},
					"LS1HttpSource_properties_typeProperties_url": {
						"value": "[parameters('LS1HttpSource_properties_typeProperties_url')]"
					},
					"LS2ADLSDestination_properties_typeProperties_url": {
						"value": "[parameters('LS2ADLSDestination_properties_typeProperties_url')]"
					},
					"LS_ADLsGen2_properties_typeProperties_url": {
						"value": "[parameters('LS_ADLsGen2_properties_typeProperties_url')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}