{
	"name": "IncrementalLoad_MultipleTable",
	"properties": {
		"activities": [
			{
				"name": "PL_Incremental_Generic",
				"description": "Parameterised pipeline for multiple tables",
				"type": "Copy",
				"dependsOn": [
					{
						"activity": "Lookup_Watermark2",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "PostgreSqlV2Source",
						"query": {
							"value": "@concat(\n'SELECT * FROM ',\npipeline().parameters.p_table_name,\n' WHERE modified_date > ''',\nactivity('Lookup_Watermark2').output.firstRow.watermark_value,\n''''\n)",
							"type": "Expression"
						},
						"queryTimeout": "00:01:00"
					},
					"sink": {
						"type": "DelimitedTextSink",
						"storeSettings": {
							"type": "AzureBlobFSWriteSettings"
						},
						"formatSettings": {
							"type": "DelimitedTextWriteSettings",
							"quoteAllText": true,
							"fileExtension": ".txt"
						}
					},
					"enableStaging": false,
					"translator": {
						"type": "TabularTranslator",
						"typeConversion": true,
						"typeConversionSettings": {
							"allowDataTruncation": true,
							"treatBooleanAsNumber": false
						}
					}
				},
				"inputs": [
					{
						"referenceName": "postgres_source",
						"type": "DatasetReference"
					}
				],
				"outputs": [
					{
						"referenceName": "ds_alds_sink",
						"type": "DatasetReference"
					}
				]
			},
			{
				"name": "Lookup_Watermark2",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "PostgreSqlV2Source",
						"query": {
							"value": "@concat(\n'SELECT watermark_value FROM watermark_control WHERE table_name = ''',\npipeline().parameters.p_table_name,\n''''\n)",
							"type": "Expression"
						},
						"queryTimeout": "02:00:00"
					},
					"dataset": {
						"referenceName": "postgres_source",
						"type": "DatasetReference"
					}
				}
			}
		],
		"parameters": {
			"p_table_name": {
				"type": "string",
				"defaultValue": "departments"
			}
		},
		"annotations": []
	}
}