{
	"name": "pipeline1_PostgresToAdls",
	"properties": {
		"activities": [
			{
				"name": "postgreeToAdls",
				"type": "Copy",
				"dependsOn": [
					{
						"activity": "Lookup_Watermark",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "PostgreSqlV2Source",
						"query": {
							"value": "@concat(\n'SELECT * FROM employees WHERE modified_date > ''',\nactivity('Lookup_Watermark').output.firstRow.watermark_value,\n''''\n)",
							"type": "Expression"
						},
						"queryTimeout": "01:00:00"
					},
					"sink": {
						"type": "DelimitedTextSink",
						"storeSettings": {
							"type": "AzureBlobFSWriteSettings"
						},
						"formatSettings": {
							"type": "DelimitedTextWriteSettings",
							"quoteAllText": true,
							"fileExtension": ".txt"
						}
					},
					"enableStaging": false,
					"translator": {
						"value": "@activity('Lookup_Watermark').output.firstRow",
						"type": "Expression"
					}
				},
				"inputs": [
					{
						"referenceName": "postgres_source",
						"type": "DatasetReference"
					}
				],
				"outputs": [
					{
						"referenceName": "ds_alds_sink",
						"type": "DatasetReference"
					}
				]
			},
			{
				"name": "Lookup_Watermark",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "PostgreSqlV2Source",
						"query": "SELECT watermark_value\nFROM watermark_control\nWHERE table_name = 'employees';",
						"queryTimeout": "02:00:00"
					},
					"dataset": {
						"referenceName": "postgres_source",
						"type": "DatasetReference"
					}
				}
			}
		],
		"annotations": []
	}
}