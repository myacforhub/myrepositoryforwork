{
	"name": "pipeline1_PostgresToAdls",
	"properties": {
		"activities": [
			{
				"name": "postgreeToAdls",
				"type": "Copy",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "PostgreSqlV2Source",
						"query": "SELECT *\nFROM dbo.employees\nWHERE joining_date > '2026-08-25'",
						"queryTimeout": "01:00:00"
					},
					"sink": {
						"type": "DelimitedTextSink",
						"storeSettings": {
							"type": "AzureBlobFSWriteSettings"
						},
						"formatSettings": {
							"type": "DelimitedTextWriteSettings",
							"quoteAllText": true,
							"fileExtension": ".txt"
						}
					},
					"enableStaging": false,
					"translator": {
						"type": "TabularTranslator",
						"mappings": [
							{
								"source": {
									"name": "employee_id",
									"type": "Int32",
									"physicalType": "integer"
								},
								"sink": {
									"name": "employee_id",
									"type": "String",
									"physicalType": "String"
								}
							},
							{
								"source": {
									"name": "employee_name",
									"type": "String",
									"physicalType": "character varying"
								},
								"sink": {
									"name": "employee_name",
									"type": "String",
									"physicalType": "String"
								}
							},
							{
								"source": {
									"name": "email",
									"type": "String",
									"physicalType": "character varying"
								},
								"sink": {
									"name": "email",
									"type": "String",
									"physicalType": "String"
								}
							},
							{
								"source": {
									"name": "department",
									"type": "String",
									"physicalType": "character varying"
								},
								"sink": {
									"name": "department",
									"type": "String",
									"physicalType": "String"
								}
							},
							{
								"source": {
									"name": "salary",
									"type": "Decimal",
									"physicalType": "numeric"
								},
								"sink": {
									"name": "salary",
									"type": "String",
									"physicalType": "String"
								}
							},
							{
								"source": {
									"name": "joining_date",
									"type": "DateTime",
									"physicalType": "date"
								},
								"sink": {
									"name": "joining_date",
									"type": "String",
									"physicalType": "String"
								}
							}
						],
						"typeConversion": true,
						"typeConversionSettings": {
							"allowDataTruncation": true,
							"treatBooleanAsNumber": false
						}
					}
				},
				"inputs": [
					{
						"referenceName": "postgres_source",
						"type": "DatasetReference"
					}
				],
				"outputs": [
					{
						"referenceName": "ds_alds_sink",
						"type": "DatasetReference"
					}
				]
			}
		],
		"annotations": []
	}
}